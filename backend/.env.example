# ─── HabitBloom Backend Environment Variables ───
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server port
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/habitbloom

# JWT secret key — use a long random string in production
JWT_SECRET=your_super_secret_key_here

# JWT token expiry duration
JWT_EXPIRE=30d

# Environment: "development" or "production"
NODE_ENV=development

# Frontend URL — used for CORS in production
# Set this to your Render app URL (e.g. https://habitbloom.onrender.com)
CLIENT_URL=http://localhost:3000